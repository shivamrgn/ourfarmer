# =============================================================================
# FieldWise Phase 3A.2.2: Backend Staging Environment Template
# File Reference: FieldWise_main/backend/.env.staging.example
# =============================================================================
# SECURITY RULES:
#   1. DO NOT commit actual secrets or staging credentials to Git.
#   2. Staging credentials MUST be completely isolated from production.
#   3. Service-role keys (SUPABASE_SERVICE_ROLE_KEY) are backend-only and must NEVER
#      be shared with frontend bundles or external clients.
#   4. Copy this file to .env.staging and populate with designated staging credentials.
# =============================================================================

# Server Port & Environment Mode
# Cloud Run dynamically assigns PORT (default fallback: 3001)
PORT=3001
NODE_ENV=staging

# CORS Policy Allowlist (MANDATORY in staging)
# Must contain comma-separated origins for both staging frontends.
# If omitted in staging mode, requests receive HTTP 403 CORS_FORBIDDEN.
FRONTEND_URL=https://staging.fieldwise.agri,https://staging-app.fieldwise.agri

# Staging Authentication JWT Secret
# DO NOT use static or test secrets. Generate a cryptographically random 256-bit secret.
# Command to generate: openssl rand -base64 32
JWT_SECRET=<generate-cryptographically-random-256bit-secret-with-openssl>
JWT_EXPIRES_IN=7d

# Staging Firebase Project Alignment
# MUST match VITE_FIREBASE_PROJECT_ID on the landing frontend.
# Used to verify Firebase ID tokens via Google x509 public certificates.
FIREBASE_PROJECT_ID=fieldwise-staging-<project-id>

# Dedicated Supabase Staging Project Configuration
# Staging project reference must be distinct from production (e.g., https://<staging-ref>.supabase.co)
SUPABASE_URL=https://<your-staging-project-ref>.supabase.co

# Privileged Server-Side Service Role Key (Required for backend-mediated persistence)
# MUST have bypass RLS capabilities on public tables.
# NEVER expose to browser clients or frontend code.
SUPABASE_SERVICE_ROLE_KEY=<your-staging-service-role-key>

# Public Anon Key for Staging (Optional on backend, used for public client fallbacks)
SUPABASE_ANON_KEY=<your-staging-anon-key>

# Cloud Persistence Switch
ENABLE_V2_CLOUD_PERSISTENCE=true

# Google Gemini API Key (Backend-only for multimodal plant leaf disease diagnostics)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# NEVER expose to browser or commit to git.
GEMINI_API_KEY=<your-staging-gemini-api-key>

# Configured Gemini Model ID (Defaults to verified gemini-1.5-flash)
# Live authenticated verification required during staging acceptance.
GEMINI_MODEL=gemini-1.5-flash

# Staging Direct PostgreSQL Connection String (Used for DBA psql migrations / backups)
# Example: postgresql://postgres:[STAGING-PASSWORD]@db.<staging-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:<staging-db-password>@db.<your-staging-project-ref>.supabase.co:5432/postgres

# OPERATIONAL NOTE ON RATE LIMITING:
# Backend rate limiters (authLoginLimiter, authRegisterLimiter, predictV1Limiter,
# predictV2Limiter, diseaseLimiter) currently utilize an in-memory sliding-window counter.
# In multi-instance Cloud Run autoscaling, limits apply per container instance.
