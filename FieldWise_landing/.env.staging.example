# =============================================================================
# FieldWise Phase 3A.2.2: Landing Frontend Staging Environment Template
# File Reference: FieldWise_landing/.env.staging.example
# =============================================================================
# SECURITY RULES:
#   1. All VITE_* variables are bundled into browser client code.
#   2. Staging credentials MUST be completely isolated from production.
#   3. Do NOT commit actual secrets or production credentials here.
#   4. Copy this file to .env.staging and populate with designated staging values.
# =============================================================================

# Dedicated Staging Firebase Project Configuration
# IMPORTANT: Must match backend FIREBASE_PROJECT_ID.
# Add staging domains in Firebase Console -> Auth -> Settings -> Authorized Domains:
#   - staging.fieldwise.agri
#   - staging-app.fieldwise.agri
VITE_FIREBASE_API_KEY=<your-staging-firebase-api-key>
VITE_FIREBASE_AUTH_DOMAIN=fieldwise-staging-<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fieldwise-staging-<project-id>
VITE_FIREBASE_STORAGE_BUCKET=fieldwise-staging-<project-id>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=<your-staging-messaging-sender-id>
VITE_FIREBASE_APP_ID=<your-staging-app-id>

# Staging Application Redirection Targets
VITE_MAIN_APP_URL=https://staging-app.fieldwise.agri
VITE_API_URL=https://staging-api.fieldwise.agri
