# =============================================================================
# FieldWise Phase 3A: Backend Production/Staging Containerfile
# File Reference: docs/deployment/templates/Dockerfile.backend
# =============================================================================
# Dual-Runtime Image: Node.js 22 LTS + Python 3.11+
# Required for Express backend + child_process execution of frozen recommendation engine.
# =============================================================================

FROM node:22-bookworm-slim AS base

# Install Python 3 standard library runtime (no heavy compiler or ML wheels needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory to project root mirroring repository directory structure
# This ensures bridgeConfig.js relative path resolution (../../../../..) succeeds
WORKDIR /app

# Copy backend dependency descriptors
COPY FieldWise_main/backend/package*.json ./FieldWise_main/backend/

# Install production dependencies for Express backend
WORKDIR /app/FieldWise_main/backend
RUN npm ci --omit=dev && npm cache clean --force

# Copy backend source code
COPY FieldWise_main/backend ./src_backend_tmp
RUN cp -r ./src_backend_tmp/* ./ && rm -rf ./src_backend_tmp

# Copy frozen Python recommendation engine and pipeline into the container
WORKDIR /app
COPY FieldWise_main/model/ml_pipeline ./FieldWise_main/model/ml_pipeline

# Switch back to backend working directory for runtime execution
WORKDIR /app/FieldWise_main/backend

# Create unprivileged application user
RUN groupadd -r fieldwise && useradd -r -g fieldwise -d /app fieldwise && \
    mkdir -p data && chown -R fieldwise:fieldwise /app

USER fieldwise

# Default environment configuration
ENV NODE_ENV=staging \
    PORT=3001 \
    FIELDWISE_PYTHON_PATH=python3 \
    FIELDWISE_BRIDGE_TIMEOUT_MS=10000

EXPOSE 3001

# Container healthcheck probing backend health endpoint dynamically
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-3001}/api/health || exit 1

CMD ["node", "src/server.js"]
