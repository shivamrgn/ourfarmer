# FieldWise Main Dashboard — Environment Variables Template

# Google Gemini API Key (multimodal plant disease detection & agronomist insights)
# Get your free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Backend REST API URL (proxied locally via /api)
VITE_API_URL=http://localhost:3001

# Landing Page URL (for logout and redirect flow)
VITE_LANDING_APP_URL=http://localhost:5173

# Optional OpenWeather API Key (fallback is automatic Open-Meteo)
VITE_OPENWEATHER_API_KEY=
